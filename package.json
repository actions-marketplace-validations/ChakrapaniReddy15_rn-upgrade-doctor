{
  "name": "rn-upgrade-doctor",
  "version": "0.2.0",
  "description": "One command to see what breaks when you upgrade a React Native app, and whether a built APK is ready for Google Play: dependencies, New Architecture, Android/iOS config, 16 KB pages, signing and Play Store rules.",
  "type": "module",
  "bin": {
    "rn-upgrade-doctor": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "examples": "tsx scripts/make-example-apks.ts && tsx scripts/run-examples.ts",
    "demo": "npm run build && tsx scripts/make-example-apks.ts && vhs docs/demo.tape"
  },
  "keywords": [
    "react-native",
    "upgrade",
    "cli",
    "new-architecture",
    "16kb",
    "android",
    "doctor",
    "apk",
    "aab",
    "google-play",
    "play-store",
    "android-manifest",
    "apk-signing"
  ],
  "author": "Sunkesula Chakrapani Reddy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChakrapaniReddy15/rn-upgrade-doctor.git"
  },
  "homepage": "https://github.com/ChakrapaniReddy15/rn-upgrade-doctor#readme",
  "bugs": {
    "url": "https://github.com/ChakrapaniReddy15/rn-upgrade-doctor/issues"
  },
  "license": "MIT",
  "dependencies": {
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.6.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/yauzl": "^2.10.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
